{
  "name": "otel-sdk-node",
  "version": "1.0.0",
  "description": "Batteries-included OpenTelemetry setup for Node.js: OTLP/gRPC tracing, Pino trace-correlated logs, and metrics, wired into an Express demo.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -w src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "assets": "node scripts/make-readme-svg.mjs"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "tracing",
    "metrics",
    "pino",
    "nodejs",
    "typescript"
  ],
  "author": "Sudhanshu Singh",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "vitest": "^4.1.12"
  }
}
